local function topButton(text, xOff, hoverColor)
    local b = create("TextButton", {
        Parent = TopBar,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOff, 0.5, 0),
        Size = UDim2.new(0, 26, 0, 26),
        BackgroundColor3 = Theme.Element,
        Font = Enum.Font.GothamBold,
        Text = text,
        TextSize = 13,
        TextColor3 = Theme.Text,
        AutoButtonColor = false,
    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundColor3 = hoverColor }) end)
    b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundColor3 = Theme.Element }) end)
    return b
end

local CloseBtn = topButton("✕", -10, Theme.Danger)
local MinBtn = topButton("–", -42, Theme.ElementHover)

makeDraggable(TopBar, Main, Scale)

local FloatBtn = create("TextButton", {
    Parent = FloatGui,
    BackgroundColor3 = Theme.Background,
    BackgroundTransparency = 0.1,
    Position = UDim2.new(0, 30, 0.5, -26),
    Size = UDim2.new(0, 52, 0, 52),
    Font = Enum.Font.GothamBold,
