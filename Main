    f.BackgroundColor3 = Theme.Element
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -56, 1, 0)
    lbl.Position = UDim2.fromOffset(10, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text
    lbl.TextColor3 = Theme.Text
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local pill = Instance.new("Frame")
    pill.Size = UDim2.fromOffset(36, 18)
    pill.Position = UDim2.new(1, -44, 0.5, -9)
    pill.BackgroundColor3 = default and Theme.Accent or Theme.Off
    pill.Parent = f
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Theme.Text
    knob.Parent = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.fromScale(1, 1)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = f

    local state = default or false
    hit.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(pill, TweenInfo.new(0.14), { BackgroundColor3 = state and Theme.Accent or Theme.Off }):Play()
        TweenService:Create(knob, TweenInfo.new(0.14), { Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }):Play()
        if cb then task.spawn(pcall, cb, state) end
    end)
    if state and cb then task.spawn(pcall, cb, true) end
end

local function addSlider(parent, text, min, max, default, suffix, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 44)
    f.BackgroundColor3 = Theme.Element
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -80, 0, 18)
    lbl.Position = UDim2.fromOffset(10, 3)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = text
    lbl.TextColor3 = Theme.Text
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 68, 0, 18)
    valLbl.Position = UDim2.new(1, -78, 0, 3)
    valLbl.BackgroundTransparency = 1
    valLbl.Font = Enum.Font.GothamBold
    valLbl.Text = tostring(default) .. (suffix or "")
    valLbl.TextColor3 = Theme.Accent
    valLbl.TextSize = 11
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = f

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.fromOffset(10, 28)
    bar.BackgroundColor3 = Theme.Off
    bar.Parent = f
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local ratio = math.clamp((default - min) / math.max(0.0001, max - min), 0, 1)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, -12, 0, 22)
    hit.Position = UDim2.fromOffset(6, 18)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.Parent = f

    local sliding = false
    local function updateAt(x)
        local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
        local raw = min + (max - min) * r
        local val = math.floor(raw * 10 + 0.5) / 10
        fill.Size = UDim2.new((val - min) / math.max(0.0001, max - min), 0, 1, 0)
        valLbl.Text = tostring(val) .. (suffix or "")
        if cb then task.spawn(pcall, cb, val) end
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            updateAt(input.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateAt(input.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end))
end

local function isSameTeam(plr)
    if not Config.TeamCheck then return false end
    if plr == LocalPlayer then return true end
    if LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
        return true
    end
    if LocalPlayer.TeamColor and plr.TeamColor and LocalPlayer.TeamColor == plr.TeamColor then
        return true
    end
    return false
end

local function isVisibleThroughWall(targetPart, cam)
    if not Config.WallCheck then return true end
    local origin = cam.CFrame.Position
    local direction = targetPart.Position - origin
    if direction.Magnitude < 0.5 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    if targetPart.Parent then table.insert(ignore, targetPart.Parent) end
    params.FilterDescendantsInstances = ignore

    local result = Workspace:Raycast(origin, direction, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(targetPart.Parent)
end

local function getBestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    local bestPart = nil
    local bestDist = Config.FovRadius

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isSameTeam(plr) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local part = char and (char:FindFirstChild(Config.AimPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            if hum and hum.Health > 0 and part and part:IsA("BasePart") then
                local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and screenPos.Z > 0 then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist2D <= bestDist and isVisibleThroughWall(part, cam) then
                        bestDist = dist2D
                        bestPart = part
                    end
                end
            end
        end
    end

    return bestPart
end

local function getCurrentVehicleSeat()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local seat = hum.SeatPart
    if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
        return seat
    end
    return nil
end

local activeTouches = {}
track(UserInputService.TouchStarted:Connect(function(touch)
    activeTouches[touch] = touch.Position
end))
track(UserInputService.TouchMoved:Connect(function(touch)
    if activeTouches[touch] then
        activeTouches[touch] = touch.Position
    end
end))
track(UserInputService.TouchEnded:Connect(function(touch)
    activeTouches[touch] = nil
end))

local function isPeGasPressed(seat)
    if seat.Throttle > 0.05 then return true end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, gui in ipairs(pg:GetDescendants()) do
            if gui:IsA("GuiButton") and gui.Visible then
                local n = string.lower(gui.Name)
                local txt = gui:IsA("TextButton") and string.lower(gui.Text) or ""
                if n:find("gas") or n:find("throttle") or n:find("accel") or n:find("drive") or n:find("pedal")
                    or txt:find("gas") or txt:find("throttle") or txt:find("accel") or txt:find("ga") then
                    local pos = gui.AbsolutePosition
                    local sz = gui.AbsoluteSize
                    for _, tPos in pairs(activeTouches) do
                        if tPos.X >= pos.X - 10 and tPos.X <= pos.X + sz.X + 10
                            and tPos.Y >= pos.Y - 10 and tPos.Y <= pos.Y + sz.Y + 10 then
                            return true
                        end
                    end
                end
            end
        end
    end

    if UserInputService.TouchEnabled then
        local cam = Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        for _, tPos in pairs(activeTouches) do
            if tPos.X > vp.X * 0.55 and tPos.Y > vp.Y * 0.45 then
                return true
            end
        end
    end

    return false
end

track(RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    FovCircle.Visible = Config.AimEnabled and Config.ShowFov
    FovCircle.Size = UDim2.fromOffset(Config.FovRadius * 2, Config.FovRadius * 2)

    if Config.AimEnabled then
        local target = getBestTarget()
        if target then
            local desiredCF = CFrame.lookAt(cam.CFrame.Position, target.Position)
            cam.CFrame = cam.CFrame:Lerp(desiredCF, math.clamp(Config.Smoothness, 0.05, 1))
        end
    end
end))

track(RunService.Heartbeat:Connect(function(dt)
    if not Config.CarSpeedEnabled then return end
    local seat = getCurrentVehicleSeat()
    if not seat then return end

    if isPeGasPressed(seat) then
        local vel = seat.AssemblyLinearVelocity
        local forward = seat.CFrame.LookVector
        local currentForwardSpeed = vel:Dot(forward)
        if currentForwardSpeed > 1 then
            local targetSpeed = math.clamp(currentForwardSpeed * Config.CarSpeedMult, -Config.CarMaxSpeed, Config.CarMaxSpeed)
            local boostDelta = (targetSpeed - currentForwardSpeed) * math.min(1, dt * 8)
            seat.AssemblyLinearVelocity = vel + forward * boostDelta
        end
    end
end))

