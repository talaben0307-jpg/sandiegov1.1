env.ZenxhubSanDiegoCleanup = function()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    for _, fn in ipairs(cleanups) do
        pcall(fn)
    end
    table.clear(cleanups)
    pcall(function() MainGui:Destroy() end)
    pcall(function() FloatGui:Destroy() end)
    pcall(function() FovGui:Destroy() end)
    env.ZenxhubSanDiegoCleanup = nil
end

CloseBtn.MouseButton1Click:Connect(function()
    if env.ZenxhubSanDiegoCleanup then env.ZenxhubSanDiegoCleanup() end
end)
closeRow.MouseButton1Click:Connect(function()
    if env.ZenxhubSanDiegoCleanup then env.ZenxhubSanDiegoCleanup() end
end)

