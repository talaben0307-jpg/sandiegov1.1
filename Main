local tabButtons, tabPages = {}, {}
local function switchTab(idx)
    for i, b in ipairs(tabButtons) do
        local active = (i == idx)
        tabPages[i].Visible = active
        b.BackgroundColor3 = active and Theme.AccentDim or Theme.Element
        b.TextColor3 = active and Theme.Accent or Theme.SubText
    end
end

local function createTab(name, idx)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 34)
    b.BackgroundColor3 = Theme.Element
    b.Font = Enum.Font.GothamSemibold
    b.Text = name
    b.TextColor3 = Theme.SubText
    b.TextSize = 12
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = SideBar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    local p = Instance.new("ScrollingFrame")
    p.Size = UDim2.fromScale(1, 1)
    p.BackgroundTransparency = 1
    p.CanvasSize = UDim2.new(0, 0, 0, 0)
    p.AutomaticCanvasSize = Enum.AutomaticSize.Y
    p.ScrollBarThickness = 2
    p.ScrollBarImageColor3 = Theme.Accent
    p.Visible = false
    p.Parent = PageArea

    local l = Instance.new("UIListLayout", p)
    l.Padding = UDim.new(0, 6)
    local pad = Instance.new("UIPadding", p)
    pad.PaddingRight = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)

    b.MouseButton1Click:Connect(function() switchTab(idx) end)
    table.insert(tabButtons, b)
    table.insert(tabPages, p)
    return p
end

