local menuVisible = true
local menuKey = Enum.KeyCode.Z

local function setMenuVisible(state)
    menuVisible = state
    MainGui.Enabled = state
    FloatGui.Enabled = not state
end

MinBtn.MouseButton1Click:Connect(function() setMenuVisible(false) end)
FloatBtn.MouseButton1Click:Connect(function()
    if not floatWasDragged() then
        setMenuVisible(true)
    end
end)
CloseBtn.MouseButton1Click:Connect(function()
    if env.ZenxhubSDCleanup then env.ZenxhubSDCleanup() end
end)

track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == menuKey then
        setMenuVisible(not menuVisible)
    end
end))

